* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Keep the Composer distribution lean: exclude everything that a consumer
# installing the master package via `composer require` does not need at runtime.
/.agents export-ignore
/.ai export-ignore
/.githooks export-ignore
/.github export-ignore
/.idea export-ignore
/docs export-ignore
/tests export-ignore
/workbench export-ignore
/keycloak export-ignore
/node_modules export-ignore
/packages/mautic export-ignore
/packages/*/tests export-ignore
/packages/*/.gitattributes export-ignore
/packages/*/.gitignore export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.mcp.json export-ignore
/.release-please-manifest.json export-ignore
/AGENTS.md export-ignore
/CHANGELOG.md export-ignore
/CLAUDE.md export-ignore
/artisan export-ignore
/astro.config.mjs export-ignore
/boost.json export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpstan.neon.dist export-ignore
/phpstan-tests.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/pint.json export-ignore
/rector.php export-ignore
/release-please-config.json export-ignore
/testbench.yaml export-ignore
