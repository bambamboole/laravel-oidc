{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bambamboole/laravel-oidc-client",
    "description": "OpenID Connect relying-party (client) for Laravel — log users in through any OIDC provider",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "oidc", "openid-connect", "oauth2", "relying-party", "sso", "client"],
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "lcobucci/jwt": "^5.0",
        "phpseclib/phpseclib": "^3.0.15"
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\LaravelOidc\\Client\\": "src/"
        }
    },
    "homepage": "https://github.com/bambamboole/laravel-oidc-client",
    "support": {
        "issues": "https://github.com/bambamboole/laravel-oidc/issues",
        "source": "https://github.com/bambamboole/laravel-oidc-client"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\LaravelOidc\\Client\\OidcClientServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
