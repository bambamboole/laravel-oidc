includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - src
        - tests
        - workbench/app
    level: 6
    ignoreErrors:
        # OAuthConsentTest.php composes the server package's InteractsWithOidc trait via a file-local
        # uses() call. pest-plugin-phpstan types `$this` accordingly, but a trait method declared
        # `: static` comes back typed as the bare trait, so the next call in the chain is reported
        # against an "unknown class". See packages/server/phpstan.neon.dist for the same entry.
        -
            identifier: class.notFound
            message: '#on an unknown class Bambamboole\\LaravelOidc\\Server\\Testing\\InteractsWithOidc#'
            path: tests/Pages/OAuthConsentTest.php
