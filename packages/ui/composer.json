{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bambamboole/laravel-oidc-ui",
    "description": "Lattice-powered auth UI for the laravel-oidc identity provider",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "oidc",
        "openid-connect",
        "auth-ui",
        "lattice"
    ],
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu"
        }
    ],
    "require": {
        "php": "^8.4",
        "bambamboole/laravel-oidc-server": "0.24.0",
        "laravel/passkeys": "^0.2.1",
        "lattice-php/lattice": ">=0.70 <1.0"
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\LaravelOidc\\Ui\\": "src/"
        }
    },
    "homepage": "https://github.com/bambamboole/laravel-oidc-ui",
    "support": {
        "issues": "https://github.com/bambamboole/laravel-oidc/issues",
        "source": "https://github.com/bambamboole/laravel-oidc-ui"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\LaravelOidc\\Ui\\UiServiceProvider"
            ]
        },
        "lattice": {
            "discover": [
                "src"
            ],
            "plugin": "resources/js/plugin.ts",
            "icons": "resources/icons"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
